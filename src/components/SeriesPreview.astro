---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getEntries } from "astro:content";
import BookCover from "./BookCover.astro";

interface Props {
  series: CollectionEntry<"series">;
}

const props = Astro.props;
const series = {
  ...props.series.data,
  books: await getEntries(props.series.data.books),
};
---

<Image id="logo" src={series.image} alt={series.title} />

<p>{series.short}</p>

<section>
  {
    series.books.map(({ data, id }) => (
      <a
        href={`/books/${id}`}
        style={`--light-color: ${data.lightColor}; --dark-color: ${data.darkColor}`}
      >
        <h3>{data.subtitle}</h3>
        <BookCover
          reducedShadow
          opening
          src={data.cover}
          alt={`Cover for ${data.title} - ${data.subtitle}`}
        />
      </a>
    ))
  }
</section>

<style>
  #logo {
    width: max(20vw, 20em);
    max-width: 100%;
    height: auto;
  }

  p {
    margin-top: 1em;
    margin-bottom: 3em;
    max-width: 70ch;
  }

  section {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 6em;

    & > a {
      color: var(--dark-color);
      text-decoration: none;

      & > h3 {
        font-size: 150%;
        margin-top: 0;
        margin-bottom: 0.8em;
        text-align: center;
        font-weight: 700;
      }
    }
  }
</style>
