---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  /** Shadow light direction on X: -1 = left, 0 = centered, 1 = right. */
  lightingX?: number;
  /** Drop the two softest / widest shadow layers. */
  reducedShadow?: boolean;
  /** On hover, open the cover slightly on a left-side hinge. */
  opening?: boolean;
}

const {
  src,
  alt,
  class: className,
  lightingX = 0,
  reducedShadow = false,
  opening = false,
} = Astro.props;
const lightingXClamped = Math.min(1, Math.max(-1, lightingX));
---

<div class:list={["book-cover-frame", className, { "is-opening": opening }]}>
  <div
    class:list={["book-cover", { "is-reduced-shadow": reducedShadow }]}
    style={`--lighting-x: ${lightingXClamped}`}
  >
    <Image {src} {alt} />
    <span class="book-cover-specular" aria-hidden="true"></span>
  </div>
</div>

<style>
  .book-cover-frame {
    width: 100%;
    line-height: 0;
  }

  @media (min-width: 1024px) {
    .book-cover-frame.is-opening {
      perspective: 1200px;
      perspective-origin: left 40%;
      container-type: inline-size;
    }

    .book-cover-frame.is-opening > .book-cover {
      /* Cover face uses its own cqw; hinge from the spine (left). */
      transform-origin: left center;
      transform-style: preserve-3d;
      transform: rotateY(0deg);
      transition: transform 0.45s ease;
    }

    .book-cover-frame.is-opening:hover > .book-cover,
    .book-cover-frame.is-opening:focus-within > .book-cover {
      transform: rotateY(-20deg);
    }
  }

  .book-cover {
    position: relative;
    width: 100%;
    line-height: 0;
    container-type: inline-size;
    /* Match closed-cover radii / table shadow from the reader. */
    border-top-left-radius: 2% 1%;
    border-bottom-left-radius: 2% 1%;
    border-top-right-radius: 1% 0.5%;
    border-bottom-right-radius: 1% 0.5%;
    overflow: hidden;
    font-size: calc(100cqw / 25);
    box-shadow:
      calc(0.2em * var(--lighting-x, -1)) 0.2em 0.3em rgb(0 0 0 / 70%),
      calc(1em * var(--lighting-x, -1)) 1em 1em rgb(0 0 0 / 30%),
      calc(2em * var(--lighting-x, -1)) 2em 2em rgb(0 0 0 / 27%),
      calc(6em * var(--lighting-x, -1)) 6em 6em rgb(0 0 0 / 20%);
  }

  .book-cover.is-reduced-shadow {
    box-shadow:
      calc(0.2em * var(--lighting-x, -1)) 0.2em 0.3em rgb(0 0 0 / 70%),
      calc(1em * var(--lighting-x, -1)) 1em 1em rgb(0 0 0 / 30%);
  }

  .book-cover > :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .book-cover-specular {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: url("/specularSinglePage.webp");
    background-repeat: no-repeat;
    background-size: 100% 100%;
    background-blend-mode: multiply;
    mix-blend-mode: soft-light;
    opacity: 0.5;
  }

  /* Spine + fore-edge shade (same as closed front cover in the reader). */
  .book-cover::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to right,
      rgb(0 0 0 / 0.5) 0%,
      transparent 0.8%,
      rgb(0 0 0 / 0.1) 3%,
      rgb(0 0 0 / 0.25) 3.5%,
      rgb(0 0 0 / 0.3) 4.5%,
      transparent 5.2%,
      transparent 99%,
      rgb(0 0 0 / 0.3) 100%
    );
  }

  @media (prefers-reduced-motion: reduce) {
    .book-cover-frame.is-opening > .book-cover {
      transition: none;
    }

    .book-cover-frame.is-opening:hover > .book-cover,
    .book-cover-frame.is-opening:focus-within > .book-cover {
      transform: none;
    }
  }
</style>
