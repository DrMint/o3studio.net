---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import Html from "../../../components/Html.astro";
import { getEntry } from "astro:content";
import Button from "../../../components/Button.astro";
import BookCover from "../../../components/BookCover.astro";
import Icon from "../../../components/Icon.astro";
import Credits from "../../../components/Credits.astro";

export async function getStaticPaths() {
  const series = await getCollection("series");
  const books = await Promise.all(
    series.flatMap((series) =>
      series.data.books.map(async (book) => ({
        series,
        book: (await getEntry(book.collection, book.id))!,
      }))
    )
  );
  return books.map(({ book, series }) => ({
    params: { id: book.id },
    props: { book, series },
  }));
}

const { book, series } = Astro.props;
const { Content: SeriesContent } = await render(series);
const pdfUrl = `/pdf/download/${book.id}.pdf`;
---

<Html>
  <div id="page">
    <Button href="/" color={book.data.darkColor}>
      <Icon name="arrow_back" />
      Go back
    </Button>
    <div
      id="layout"
      style={`--light-color: ${book.data.lightColor}; --dark-color: ${book.data.darkColor}`}
    >
      <div id="left">
        <BookCover
          lightingX={-0.5}
          src={book.data.cover}
          alt={`Cover for ${book.data.title} - ${book.data.subtitle}`}
        />
      </div>
      <div id="right">
        <div id="series-card">
          <Image id="logo" src={series.data.image} alt={series.data.title} />
          <div>
            <SeriesContent />
          </div>
        </div>
        <div id="actions">
          {
            book.data.upcoming ? (
              <Button href="" color={book.data.darkColor} primary disabled>
                Upcoming
              </Button>
            ) : (
              <>
                <span id="read-online">
                  <Button
                    href={`/books/${book.id}/read`}
                    color={book.data.darkColor}
                    primary
                  >
                    <Icon name="menu_book" />
                    Read online
                  </Button>
                </span>
                <span id="download-secondary">
                  <Button
                    href={pdfUrl}
                    download={`${book.id}.pdf`}
                    color={book.data.darkColor}
                  >
                    <Icon name="download" />
                    Download
                  </Button>
                </span>
                <span id="download-primary">
                  <Button
                    href={pdfUrl}
                    download={`${book.id}.pdf`}
                    color={book.data.darkColor}
                    primary
                  >
                    <Icon name="download" />
                    Download
                  </Button>
                </span>
              </>
            )
          }
        </div>
        <Credits />
      </div>
    </div>
  </div>
</Html>

<style>
  #read-online,
  #download-secondary {
    display: contents;
  }

  #download-primary {
    display: none;
  }

  @media (max-width: 480px), (max-height: 520px) {
    #read-online,
    #download-secondary {
      display: none;
    }

    #download-primary {
      display: contents;
    }
  }

  #page {
    padding: clamp(24px, 4vw, 64px);
    display: flex;
    flex-direction: column;
    gap: 6vh;
    place-items: flex-start;
  }

  #layout {
    display: grid;
    grid-template-columns: calc(70vh * 21 / 29.7) auto;
    gap: 1em 6vw;
    place-content: center;
    width: 100%;

    & > #left {
      display: flex;
      flex-direction: column;
      place-items: start;
      gap: 1em;
    }

    @media (max-width: calc(70vh * 21 / 29.7 + 60ch)) {
      grid-template-columns: unset;

      & > #left {
        margin-bottom: calc(70vh * 21 / 29.7 * 0.2);
      }
    }

    & > #right {
      display: flex;
      flex-direction: column;
      gap: 3em;
      place-items: start;

      & > #actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75em;
      }

      & > #series-card {
        background-color: white;
        border: 3px solid var(--light-color);
        width: fit-content;
        max-width: 70ch;
        padding: 1.5em;
        padding-right: 2em;
        padding-bottom: 1em;
        display: flex;
        flex-direction: column;

        & > :global(*) {
          margin: 0 !important;
        }
      }
    }
  }

  #logo {
    width: max(20vw, 20em);
    max-width: 100%;
    height: auto;
  }
</style>
