---
import { getCollection, getEntry } from "astro:content";
import Html from "../../../components/Html.astro";
import Button from "../../../components/Button.astro";

export async function getStaticPaths() {
  const series = await getCollection("series");
  const books = await Promise.all(
    series.flatMap((series) =>
      series.data.books.map(async (book) => ({
        series,
        book: (await getEntry(book.collection, book.id))!,
      }))
    )
  );
  return books.map(({ book, series }) => ({
    params: { id: book.id },
    props: { book, series },
  }));
}

const { book } = Astro.props;
const pdfUrl = `/pdf/${book.id}.pdf`;
---

<Html>
  <div
    id="reader"
    data-pdf-url={pdfUrl}
    style={`--light-color: ${book.data.lightColor}; --dark-color: ${book.data.darkColor}`}
  >
    <header id="toolbar">
      <Button href={`/books/${book.id}`} color={book.data.darkColor}>
        {"<"} Go back
      </Button>
      <div id="titles">
        <h1 id="book-title">
          {book.data.title}
        </h1>
        <p id="book-subtitle">{book.data.subtitle}</p>
      </div>
    </header>
    <div id="spread">
      <div id="book" data-closed="true" data-cover="front">
        <button
          type="button"
          class="page"
          data-page="left"
          data-empty="true"
          data-active="false"
          aria-label="Previous pages"
        >
          <span class="page-shell">
            <span class="page-edge" aria-hidden="true"></span>
            <span class="page-face">
              <canvas></canvas>
            </span>
          </span>
        </button>
        <button
          type="button"
          class="page"
          data-page="right"
          data-empty="true"
          data-active="false"
          aria-label="Next pages"
        >
          <span class="page-shell">
            <span class="page-face">
              <canvas></canvas>
            </span>
            <span class="page-edge" aria-hidden="true"></span>
          </span>
        </button>
      </div>
    </div>
  </div>
</Html>

<script>
  import { initBookReader } from "../../../scripts/book-reader";

  const root = document.getElementById("reader");
  if (root) void initBookReader(root);
</script>

<style is:global>
  html:has(#reader),
  body:has(#reader) {
    margin: 0;
    height: 100%;
    overflow: hidden;
  }

  body:has(#reader) {
    height: 100dvh;
  }
</style>

<style>
  #reader {
    box-sizing: border-box;
    height: 100dvh;
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 0.75rem;
    padding: clamp(12px, 2vw, 28px);
    padding-bottom: clamp(12px, 3vw, 56px);
  }

  #toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    min-width: 0;
  }

  #titles {
    min-width: 0;
    color: var(--dark-color);
  }

  #series-title {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 600;
    opacity: 0.75;
  }

  #book-title {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.2;
  }

  #book-subtitle {
    font-weight: 500;
    opacity: 0.8;
    line-height: 1;
    margin: 0;
  }

  #spread {
    min-height: 0;
    display: grid;
    place-items: center;
  }

  #book {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    max-width: 100%;
    max-height: 100%;
  }

  #book:not([data-closed="true"]),
  #book[data-closed="true"] .page:not([data-empty="true"]) .page-shell {
    box-shadow:
      0 0.1em 0.3em rgb(0 0 0 / 70%),
      0 1em 1em rgb(0 0 0 / 30%),
      0 2em 2em rgb(0 0 0 / 27%),
      0 12em 12em rgb(0 0 0 / 50%);
  }

  .page {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    display: block;
    line-height: 0;
    cursor: default;
  }

  .page[data-active="true"] {
    cursor: pointer;
  }

  .page[data-page="left"][data-active="true"] {
    cursor: w-resize;
  }

  .page[data-page="right"][data-active="true"] {
    cursor: e-resize;
  }

  .page[data-empty="true"] {
    visibility: hidden;
    pointer-events: none;
  }

  .page-shell {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    line-height: 0;
  }

  .page-edge {
    flex: 0 0 auto;
    width: var(--edge-width, 0px);
    background-color: #d0d0d0;
    background-image: url("/side-book.webp");
    background-repeat: repeat-x;
    background-size: auto 100%;
    background-position: center left;
  }

  .page[data-page="right"] .page-edge {
    transform: scaleX(-1);
  }

  .page-face {
    position: relative;
    flex: 0 0 auto;
    display: block;
    overflow: hidden;
  }

  .page-face::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .page[data-page="left"] .page-face::after {
    background: linear-gradient(
      to right,
      transparent 80%,
      rgb(0 0 0 / 0.01) 90%,
      rgb(0 0 0 / 0.05) 95%,
      rgb(0 0 0 / 0.1) 99%,
      rgb(0 0 0 / 0.15) 99.5%,
      rgb(0 0 0 / 0.3) 100%
    );
  }

  .page[data-page="right"] .page-face::after {
    background: linear-gradient(
      to left,
      transparent 80%,
      rgb(0 0 0 / 0.01) 90%,
      rgb(0 0 0 / 0.05) 95%,
      rgb(0 0 0 / 0.1) 99%,
      rgb(0 0 0 / 0.15) 99.5%,
      rgb(0 0 0 / 0.3) 100%
    );
  }

  #book[data-cover="front"] .page[data-page="right"] .page-face::after {
    background: linear-gradient(
      to right,
      rgb(0 0 0 / 0.5) 0%,
      transparent 0.8%,
      rgb(0 0 0 / 0.1) 3%,
      rgb(0 0 0 / 0.25) 3.5%,
      rgb(0 0 0 / 0.3) 4.5%,
      transparent 5.2%
    );
  }

  #book[data-cover="back"] .page[data-page="left"] .page-face::after {
    background: linear-gradient(
      to left,
      rgb(0 0 0 / 0.5) 0%,
      transparent 0.8%,
      rgb(0 0 0 / 0.1) 3%,
      rgb(0 0 0 / 0.25) 3.5%,
      rgb(0 0 0 / 0.3) 4.5%,
      transparent 5.2%
    );
  }

  .page-face > canvas {
    display: block;
    max-width: 100%;
    max-height: 100%;
  }
</style>
