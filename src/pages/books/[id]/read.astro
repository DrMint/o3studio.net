---
import { getCollection, getEntry } from "astro:content";
import Html from "../../../components/Html.astro";
import Button from "../../../components/Button.astro";

export async function getStaticPaths() {
  const series = await getCollection("series");
  const books = await Promise.all(
    series.flatMap((series) =>
      series.data.books.map(async (book) => ({
        series,
        book: (await getEntry(book.collection, book.id))!,
      }))
    )
  );
  return books.map(({ book, series }) => ({
    params: { id: book.id },
    props: { book, series },
  }));
}

const { book } = Astro.props;
const pdfUrl = `/pdf/${book.id}.pdf`;
---

<Html>
  <div
    id="reader"
    data-pdf-url={pdfUrl}
    style={`--light-color: ${book.data.lightColor}; --dark-color: ${book.data.darkColor}`}
  >
    <header id="toolbar">
      <Button href={`/books/${book.id}`} color={book.data.darkColor}>
        {"<"} Go back
      </Button>
      <div id="titles">
        <h1 id="book-title">
          {book.data.title}
        </h1>
        <p id="book-subtitle">{book.data.subtitle}</p>
      </div>
      <div id="toolbar-actions">
        <label id="page-jump">
          <span>Page</span>
          <input
            type="number"
            data-page-input
            min="1"
            value="1"
            inputmode="numeric"
          />
          <span data-page-count></span>
        </label>
        <div id="zoom-controls">
          <button type="button" data-zoom-out aria-label="Zoom out">−</button>
          <button type="button" data-zoom-reset>
            <span data-zoom-label>100%</span>
          </button>
          <button type="button" data-zoom-in aria-label="Zoom in">+</button>
        </div>
        <Button
          href={pdfUrl}
          download={`${book.id}.pdf`}
          color={book.data.darkColor}
        >
          Download
        </Button>
      </div>
    </header>
    <label id="page-scrubber">
      <span class="visually-hidden">Jump to page</span>
      <input type="range" data-page-slider min="1" value="1" step="1" />
    </label>
    <div id="spread">
      <div id="spread-stage">
        <div id="book-zoom-shell">
          <div
            id="book"
            data-closed="true"
            data-cover="front"
            data-zoomed="false"
          >
        <div
          class="page"
          data-page="left"
          data-empty="true"
          data-active="false"
          role="button"
          tabindex="0"
          aria-label="Previous pages"
        >
          <span class="page-shell">
            <span class="page-edge" aria-hidden="true"></span>
            <span class="page-face">
              <canvas></canvas>
              <div class="textLayer" hidden></div>
            </span>
          </span>
        </div>
        <div
          class="page"
          data-page="right"
          data-empty="true"
          data-active="false"
          role="button"
          tabindex="0"
          aria-label="Next pages"
        >
          <span class="page-shell">
            <span class="page-face">
              <canvas></canvas>
              <div class="textLayer" hidden></div>
            </span>
            <span class="page-edge" aria-hidden="true"></span>
          </span>
        </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Html>

<script>
  import { initBookReader } from "../../../scripts/book-reader";

  const root = document.getElementById("reader");
  if (root) void initBookReader(root);
</script>

<style is:global>
  html:has(#reader),
  body:has(#reader) {
    margin: 0;
    height: 100%;
    overflow: hidden;
  }

  body:has(#reader) {
    height: 100dvh;
  }
</style>

<style>
  #reader {
    box-sizing: border-box;
    height: 100dvh;
    display: grid;
    grid-template-rows: auto auto 1fr;
    gap: 0.75rem;
  }

  #toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    min-width: 0;
    padding: clamp(12px, 2vw, 28px);
    padding-bottom: 0;
  }

  #titles {
    min-width: 0;
    color: var(--dark-color);
  }

  #toolbar-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 2rem;
    margin-left: auto;
  }

  #page-jump {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--dark-color);
    font-weight: 600;
    font-size: 1.3rem;
  }

  #page-jump input {
    max-width: 6ch;
    box-sizing: content-box;
    margin: 0;
    padding: 0.35em 0.45em;
    border: 3px solid var(--dark-color);
    background: white;
    color: var(--dark-color);
    font: inherit;
    font-weight: 600;
    text-align: center;
  }

  #zoom-controls {
    display: flex;
    align-items: stretch;
    border: 3px solid var(--dark-color);
    background: white;
    color: var(--dark-color);
    font-size: 26px;
  }

  #zoom-controls > button {
    margin: 0;
    padding: 0.35em 0.65em;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
  }

  #zoom-controls > button:hover,
  #zoom-controls > button:focus-visible {
    background: var(--dark-color);
    color: white;
  }

  #zoom-controls > [data-zoom-reset] {
    min-width: 4.5em;
    border-inline: 3px solid var(--dark-color);
    font-weight: 600;
    font-size: 1.2rem;
  }

  #zoom-controls > button:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  #zoom-controls > button:disabled:hover {
    background: transparent;
    color: inherit;
  }

  #page-scrubber {
    display: block;
    min-width: 0;
    padding-inline: clamp(12px, 2vw, 28px);
  }

  #page-scrubber input {
    width: 100%;
    margin: 0;
    accent-color: var(--dark-color);
    cursor: pointer;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  #series-title {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 600;
    opacity: 0.75;
  }

  #book-title {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.2;
  }

  #book-subtitle {
    font-weight: 500;
    opacity: 0.8;
    line-height: 1;
    margin: 0;
  }

  #spread {
    min-height: 0;
    overflow: auto;
  }

  #spread-stage {
    box-sizing: border-box;
    display: grid;
    place-items: center;
    min-width: 100%;
    min-height: 100%;
    width: max-content;
    height: max-content;
    /* Room for the book shadow inside the scrollport (incl. soft ambient). */
    padding: 5em;
  }

  #book-zoom-shell {
    width: max-content;
    height: max-content;
    line-height: 0;
  }

  #book {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    width: max-content;
    max-width: none;
    transform-origin: 0 0;
  }

  #book.is-preview-zoom {
    will-change: transform;
  }

  #book:not([data-closed="true"]),
  #book[data-closed="true"] .page:not([data-empty="true"]) .page-shell {
    box-shadow:
      0 0.1em 0.3em rgb(0 0 0 / 70%),
      0 1em 1em rgb(0 0 0 / 30%),
      0 2em 2em rgb(0 0 0 / 27%),
      0 12em 12em rgb(0 0 0 / 50%);
  }

  .page {
    box-sizing: border-box;
    flex: 0 0 auto;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    display: block;
    line-height: 0;
    cursor: default;
  }

  .page[data-empty="true"] {
    visibility: hidden;
    pointer-events: none;
  }

  .page-shell {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    flex: 0 0 auto;
    line-height: 0;
  }

  .page-edge {
    flex: 0 0 auto;
    width: var(--edge-width, 0px);
    background-color: #d0d0d0;
    background-image: url("/side-book.webp");
    background-repeat: repeat-x;
    background-size: auto 100%;
    background-position: center left;
  }

  .page[data-page="right"] .page-edge {
    transform: scaleX(-1);
  }

  .page-face {
    position: relative;
    flex: 0 0 auto;
    display: block;
    overflow: hidden;
  }

  .page-face > canvas {
    display: block;
    position: relative;
    z-index: 0;
  }

  .page-face > .textLayer {
    z-index: 1;
  }

  #book:not([data-cover]) .page-face::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background-image: url("/paper-book.webp");
    opacity: 0.5;
    mix-blend-mode: exclusion;
    background-size: 20vmin 20vmin;
  }

  .page-face::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
  }

  .page[data-page="left"] .page-face::after {
    background: linear-gradient(
      to right,
      transparent 80%,
      rgb(0 0 0 / 0.01) 90%,
      rgb(0 0 0 / 0.05) 95%,
      rgb(0 0 0 / 0.1) 99%,
      rgb(0 0 0 / 0.15) 99.5%,
      rgb(0 0 0 / 0.3) 100%
    );
  }

  .page[data-page="right"] .page-face::after {
    background: linear-gradient(
      to left,
      transparent 80%,
      rgb(0 0 0 / 0.01) 90%,
      rgb(0 0 0 / 0.05) 95%,
      rgb(0 0 0 / 0.1) 99%,
      rgb(0 0 0 / 0.15) 99.5%,
      rgb(0 0 0 / 0.3) 100%
    );
  }

  #book[data-cover="front"] .page[data-page="right"] .page-face::after {
    background: linear-gradient(
      to right,
      rgb(0 0 0 / 0.5) 0%,
      transparent 0.8%,
      rgb(0 0 0 / 0.1) 3%,
      rgb(0 0 0 / 0.25) 3.5%,
      rgb(0 0 0 / 0.3) 4.5%,
      transparent 5.2%
    );
  }

  #book[data-cover="back"] .page[data-page="left"] .page-face::after {
    background: linear-gradient(
      to left,
      rgb(0 0 0 / 0.5) 0%,
      transparent 0.8%,
      rgb(0 0 0 / 0.1) 3%,
      rgb(0 0 0 / 0.25) 3.5%,
      rgb(0 0 0 / 0.3) 4.5%,
      transparent 5.2%
    );
  }
</style>

<style is:global>
  .textLayer {
    position: absolute;
    inset: 0;
    overflow: clip;
    opacity: 1;
    line-height: 1;
    text-size-adjust: none;
    transform-origin: 0 0;
    caret-color: CanvasText;
  }

  .textLayer :is(span, br) {
    color: transparent;
    position: absolute;
    white-space: pre;
    cursor: text;
    transform-origin: 0% 0%;
    user-select: text;
  }

  .textLayer {
    --min-font-size: 1;
    --text-scale-factor: calc(var(--total-scale-factor) * var(--min-font-size));
    --min-font-size-inv: calc(1 / var(--min-font-size));
  }

  .textLayer > :not(.markedContent),
  .textLayer .markedContent span:not(.markedContent) {
    z-index: 1;
    --font-height: 0;
    font-size: calc(var(--text-scale-factor) * var(--font-height));
    --scale-x: 1;
    --rotate: 0deg;
    transform: rotate(var(--rotate)) scaleX(var(--scale-x))
      scale(var(--min-font-size-inv));
  }

  .textLayer .markedContent {
    display: contents;
  }

  .textLayer ::selection {
    background: rgb(0 100 255 / 0.35);
  }
</style>
