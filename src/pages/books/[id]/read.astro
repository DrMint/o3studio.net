---
import { getCollection, getEntry } from "astro:content";
import Html from "../../../components/Html.astro";
import Button from "../../../components/Button.astro";
import Icon from "../../../components/Icon.astro";

export async function getStaticPaths() {
  const series = await getCollection("series");
  const books = await Promise.all(
    series.flatMap((series) =>
      series.data.books.map(async (book) => ({
        series,
        book: (await getEntry(book.collection, book.id))!,
      }))
    )
  );
  return books.map(({ book, series }) => ({
    params: { id: book.id },
    props: { book, series },
  }));
}

const { book } = Astro.props;
const pdfUrl = `/pdf/${book.id}.pdf`;
---

<Html>
  <div
    id="reader"
    data-book-id={book.id}
    data-pdf-url={pdfUrl}
    style={`--light-color: ${book.data.lightColor}; --dark-color: ${book.data.darkColor}`}
  >
    <header id="toolbar">
      <Button href={`/books/${book.id}`} color={book.data.darkColor}>
        <Icon name="arrow_back" />
        Go back
      </Button>
      <div id="titles">
        <h1 id="book-title">
          {book.data.title}
        </h1>
        <p id="book-subtitle">{book.data.subtitle}</p>
      </div>
      <div id="toolbar-actions">
        <label id="page-jump">
          <span>Page</span>
          <input
            type="number"
            data-page-input
            min="1"
            value="1"
            inputmode="numeric"
          />
          <span data-page-count></span>
        </label>
        <div id="zoom-controls">
          <button type="button" data-zoom-out aria-label="Zoom out">
            <Icon name="zoom_out" />
          </button>
          <button type="button" data-zoom-reset>
            <span data-zoom-label>100%</span>
          </button>
          <button type="button" data-zoom-in aria-label="Zoom in">
            <Icon name="zoom_in" />
          </button>
        </div>
        <Button
          href={pdfUrl}
          download={`${book.id}.pdf`}
          color={book.data.darkColor}
        >
          <Icon name="download" />
          Download
        </Button>
        <button
          type="button"
          id="fullscreen-enter"
          aria-label="Fullscreen"
          title="Fullscreen"
        >
          <Icon name="fullscreen" />
        </button>
      </div>
    </header>
    <label id="page-scrubber">
      <span class="visually-hidden">Jump to page</span>
      <input type="range" data-page-slider min="1" value="1" step="1" />
    </label>
    <div id="spread-area">
      <button
        type="button"
        id="fullscreen-exit"
        aria-label="Exit fullscreen"
        title="Exit fullscreen"
        hidden
      >
        <Icon name="fullscreen_exit" />
      </button>
      <button
        type="button"
        id="turn-prev"
        data-turn="prev"
        aria-label="Previous pages"
      >
        <Icon name="chevron_left" size="2rem" />
      </button>
      <div id="spread">
        <div id="spread-stage">
          <div id="book-zoom-shell">
            <div
              id="book"
              data-closed="true"
              data-cover="front"
              data-zoomed="false"
            >
              <div class="page" data-page="left" data-empty="true">
                <span class="page-shell">
                  <span class="page-edge" aria-hidden="true"></span>
                  <span class="page-face">
                    <canvas></canvas>
                    <div class="textLayer" hidden></div>
                  </span>
                </span>
                <span class="page-tint" aria-hidden="true"></span>
                <span class="page-fold" aria-hidden="true"></span>
                <span class="page-lighting" aria-hidden="true"></span>
                <span class="page-specular" aria-hidden="true"></span>
              </div>
              <div class="page" data-page="right" data-empty="true">
                <span class="page-shell">
                  <span class="page-face">
                    <canvas></canvas>
                    <div class="textLayer" hidden></div>
                  </span>
                  <span class="page-edge" aria-hidden="true"></span>
                </span>
                <span class="page-tint" aria-hidden="true"></span>
                <span class="page-fold" aria-hidden="true"></span>
                <span class="page-lighting" aria-hidden="true"></span>
                <span class="page-specular" aria-hidden="true"></span>
              </div>
            </div>
          </div>
        </div>
      </div>
      <button
        type="button"
        id="turn-next"
        data-turn="next"
        aria-label="Next pages"
      >
        <Icon name="chevron_right" size="2rem" />
      </button>
    </div>
    <div
      id="small-screen-overlay"
      role="dialog"
      aria-modal="true"
      aria-labelledby="small-screen-title"
    >
      <Icon name="devices" size="3rem" />
      <h2 id="small-screen-title">Screen too small</h2>
      <p>
        This reader needs more space for a two-page spread. Open it on a larger
        device, or download the PDF to read offline.
      </p>
      <div id="small-screen-actions">
        <Button
          href={pdfUrl}
          download={`${book.id}.pdf`}
          color={book.data.darkColor}
          primary
        >
          <Icon name="download" />
          Download PDF
        </Button>
        <Button href={`/books/${book.id}`} color={book.data.darkColor}>
          <Icon name="arrow_back" />
          Go back
        </Button>
      </div>
    </div>
  </div>
</Html>

<script>
  import { initBookReader } from "../../../scripts/book-reader";

  const root = document.getElementById("reader");
  if (root) void initBookReader(root);
</script>

<style is:global>
  html:has(#reader),
  body:has(#reader) {
    margin: 0;
    height: 100%;
    overflow: hidden;
  }

  body:has(#reader) {
    height: 100dvh;
  }
</style>

<style>
  #reader {
    box-sizing: border-box;
    height: 100dvh;
    display: grid;
    grid-template-rows: auto auto 1fr;
    gap: 0.75rem;
    position: relative;
  }

  #small-screen-overlay {
    display: none;
    position: absolute;
    inset: 0;
    z-index: 20;
    box-sizing: border-box;
    padding: 2rem 1.5rem;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    text-align: center;
    color: var(--dark-color);
    background-color: rgb(255 251 249 / 0.96);
    background-image: url("/paper2.webp");
    background-size: 25cm;
    background-repeat: round;
  }

  #small-screen-overlay h2 {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
  }

  #small-screen-overlay p {
    margin: 0;
    max-width: 28ch;
    font-size: 1.05rem;
    line-height: 1.45;
  }

  #small-screen-actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  @media (max-width: 480px), (max-height: 520px) {
    #small-screen-overlay {
      display: flex;
    }
  }

  #toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    min-width: 0;
    padding: clamp(12px, 2vw, 28px);
    padding-bottom: 0;
  }

  #titles {
    min-width: 0;
    color: var(--dark-color);
  }

  #toolbar-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 2rem;
    margin-left: auto;
  }

  #toolbar :global(a) {
    box-sizing: border-box;
    height: 50px;
    padding-block: 0;
  }

  #page-jump {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--dark-color);
    font-weight: 600;
    font-size: 1.3rem;
  }

  #page-jump input {
    box-sizing: border-box;
    height: 50px;
    max-width: 8ch;
    margin: 0;
    padding: 0 0.45em;
    border: 3px solid var(--dark-color);
    background: white;
    color: var(--dark-color);
    font: inherit;
    font-weight: 600;
    text-align: center;
  }

  #zoom-controls {
    box-sizing: border-box;
    display: flex;
    align-items: stretch;
    height: 50px;
    border: 3px solid var(--dark-color);
    background: white;
    color: var(--dark-color);
    font-size: 26px;
  }

  #zoom-controls > button {
    margin: 0;
    padding: 0 0.65em;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  #zoom-controls > button:hover,
  #zoom-controls > button:focus-visible {
    background: var(--dark-color);
    color: white;
  }

  #zoom-controls > [data-zoom-reset] {
    min-width: 4.5em;
    border-inline: 3px solid var(--dark-color);
    font-weight: 600;
    font-size: 1.2rem;
  }

  #zoom-controls > button:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  #zoom-controls > button:disabled:hover {
    background: transparent;
    color: inherit;
  }

  #page-scrubber {
    display: block;
    min-width: 0;
    padding-inline: clamp(12px, 2vw, 28px);
  }

  #page-scrubber input {
    width: 100%;
    margin: 0;
    accent-color: var(--dark-color);
    cursor: pointer;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  #series-title {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 600;
    opacity: 0.75;
  }

  #book-title {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.2;
  }

  #book-subtitle {
    font-size: 0.9rem;
    margin: 0;
  }

  #spread-area {
    position: relative;
    min-height: 0;
    overflow: hidden;
    touch-action: pan-x pan-y;
  }

  #spread-area:fullscreen {
    box-sizing: border-box;
    width: 100%;
    height: 100%;
    background-image: url("/paper2.webp");
    background-size: 25cm;
    background-repeat: round;
  }

  #fullscreen-enter,
  #fullscreen-exit {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    width: 50px;
    height: 50px;
    border: 3px solid var(--dark-color);
    background: white;
    color: var(--dark-color);
    font: inherit;
    line-height: 1;
    cursor: pointer;
    user-select: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  #fullscreen-enter:hover,
  #fullscreen-enter:focus-visible,
  #fullscreen-exit:hover,
  #fullscreen-exit:focus-visible {
    background: var(--dark-color);
    color: white;
  }

  #fullscreen-exit {
    position: absolute;
    top: clamp(12px, 2vw, 28px);
    right: clamp(12px, 2vw, 28px);
    z-index: 6;
    display: none;
  }

  #spread-area:fullscreen #fullscreen-exit {
    display: inline-flex;
  }

  #turn-prev,
  #turn-next {
    position: absolute;
    top: 50%;
    z-index: 5;
    transform: translateY(-50%);
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    width: 50px;
    height: 50px;
    border: 3px solid var(--dark-color);
    background: white;
    color: var(--dark-color);
    font: inherit;
    line-height: 1;
    cursor: pointer;
    user-select: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  #turn-prev {
    left: clamp(12px, 2vw, 28px);
  }

  #turn-next {
    right: clamp(12px, 2vw, 28px);
  }

  #turn-prev:hover,
  #turn-next:hover,
  #turn-prev:focus-visible,
  #turn-next:focus-visible {
    background: var(--dark-color);
    color: white;
  }

  #turn-prev:disabled,
  #turn-next:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  #turn-prev:disabled:hover,
  #turn-next:disabled:hover {
    background: white;
    color: var(--dark-color);
  }

  #spread {
    position: absolute;
    inset: 0;
    overflow: auto;
    touch-action: pan-x pan-y;
  }

  #spread-stage {
    box-sizing: border-box;
    display: grid;
    place-items: center;
    min-width: 100%;
    min-height: 100%;
    width: max-content;
    height: max-content;
    /* Room for the book shadow inside the scrollport (incl. soft ambient). */
    padding: clamp(0.5rem, 5vmin, 5rem);
  }

  #book-zoom-shell {
    width: max-content;
    height: max-content;
    line-height: 0;
  }

  #book {
    position: relative;
    display: flex;
    flex-direction: row;
    align-items: stretch;
    width: max-content;
    max-width: none;
    transform-origin: 0 0;
  }

  #book.is-preview-zoom {
    will-change: transform;
  }

  #book:not([data-closed="true"]),
  #book[data-closed="true"] .page:not([data-empty="true"]) .page-shell {
    box-shadow:
      0 0.2em 0.3em rgb(0 0 0 / 70%),
      0 1em 1em rgb(0 0 0 / 30%),
      0 2em 2em rgb(0 0 0 / 27%),
      0 12em 12em rgb(0 0 0 / 50%);
  }

  .page {
    box-sizing: border-box;
    flex: 0 0 auto;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    display: block;
    line-height: 0;
    cursor: default;
    position: relative;
  }

  .page[data-empty="true"] {
    display: none;
  }

  .page-shell {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    flex: 0 0 auto;
    line-height: 0;
  }

  .page-edge {
    flex: 0 0 auto;
    width: calc(var(--edge-ratio, 0) * var(--page-face-width, 0px));
    background-color: #d0d0d0;
    background-image: url("/side-book.webp");
    background-repeat: repeat-x;
    background-size: auto 100%;
    background-position: center left;
  }

  .page[data-page="right"] .page-edge {
    transform: scaleX(-1);
  }

  .page-face {
    position: relative;
    flex: 0 0 auto;
    display: block;
    overflow: hidden;
  }

  .page-face > canvas {
    display: block;
    position: relative;
    z-index: 0;
  }

  .page-face > .textLayer {
    z-index: 1;
  }

  /* Apply order: paper → tint → fold → lighting → specular */
  .page-face::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background-image: url("/paper-book.webp");
    opacity: 0.5;
    mix-blend-mode: exclusion;
    background-size: 20vmin 20vmin;
  }

  .page-tint {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    background: #fffbf9;
    mix-blend-mode: multiply;
  }

  #book[data-cover] .page-tint {
    display: none;
  }

  .page-fold {
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
    background-image: url("/bookFold.webp");
    background-repeat: no-repeat;
    background-size: 200% 100%;
    mix-blend-mode: multiply;
  }

  .page[data-page="left"] .page-fold {
    background-position: left center;
  }

  .page[data-page="right"] .page-fold {
    background-position: right center;
  }

  #book[data-cover] .page-fold {
    display: none;
  }

  .page-lighting {
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
    background-image: url("/lightingDoublePage.webp");
    background-repeat: no-repeat;
    background-size: 200% 100%;
    mix-blend-mode: multiply;
    opacity: 0.3;
  }

  .page[data-page="left"] .page-lighting {
    background-position: left center;
  }

  .page[data-page="right"] .page-lighting {
    background-position: right center;
  }

  #book[data-cover] .page-lighting {
    background-image: url("/lightingSinglePage.webp");
    background-size: 100% 100%;
    background-position: center;
  }

  .page-specular {
    position: absolute;
    inset: 0;
    z-index: 6;
    pointer-events: none;
    background-image: url("/specularDoublePage.webp");
    background-repeat: no-repeat;
    background-size: 200% 100%;
    background-blend-mode: multiply;
    mix-blend-mode: soft-light;
    opacity: 0.5;
  }

  .page[data-page="left"] .page-specular {
    background-position: left center;
  }

  .page[data-page="right"] .page-specular {
    background-position: right center;
  }

  #book[data-cover] .page-specular {
    background-image: url("/specularSinglePage.webp");
    background-size: 100% 100%;
    background-position: center;
  }

  .page-face::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 7;
    pointer-events: none;
  }

  #book[data-cover="front"] .page[data-page="right"] .page-face::after {
    background: linear-gradient(
      to right,
      rgb(0 0 0 / 0.5) 0%,
      transparent 0.8%,
      rgb(0 0 0 / 0.1) 3%,
      rgb(0 0 0 / 0.25) 3.5%,
      rgb(0 0 0 / 0.3) 4.5%,
      transparent 5.2%
    );
  }

  #book[data-cover="back"] .page[data-page="left"] .page-face::after {
    background: linear-gradient(
      to left,
      rgb(0 0 0 / 0.5) 0%,
      transparent 0.8%,
      rgb(0 0 0 / 0.1) 3%,
      rgb(0 0 0 / 0.25) 3.5%,
      rgb(0 0 0 / 0.3) 4.5%,
      transparent 5.2%
    );
  }
</style>

<style is:global>
  .textLayer {
    position: absolute;
    inset: 0;
    overflow: clip;
    opacity: 1;
    line-height: 1;
    text-size-adjust: none;
    transform-origin: 0 0;
    caret-color: CanvasText;
  }

  .textLayer :is(span, br) {
    color: transparent;
    position: absolute;
    white-space: pre;
    cursor: text;
    transform-origin: 0% 0%;
    user-select: text;
  }

  .textLayer {
    --min-font-size: 1;
    --text-scale-factor: calc(var(--total-scale-factor) * var(--min-font-size));
    --min-font-size-inv: calc(1 / var(--min-font-size));
  }

  .textLayer > :not(.markedContent),
  .textLayer .markedContent span:not(.markedContent) {
    z-index: 1;
    --font-height: 0;
    font-size: calc(var(--text-scale-factor) * var(--font-height));
    --scale-x: 1;
    --rotate: 0deg;
    transform: rotate(var(--rotate)) scaleX(var(--scale-x))
      scale(var(--min-font-size-inv));
  }

  .textLayer .markedContent {
    display: contents;
  }

  .textLayer ::selection {
    background: rgb(0 100 255 / 0.35);
  }
</style>
