---
import Icon from "../../../../components/Icon.astro";
---

<dialog id="shortcuts-dialog" aria-labelledby="shortcuts-title">
  <div class="shortcuts-panel">
    <div class="shortcuts-header">
      <h2 id="shortcuts-title">Keyboard shortcuts</h2>
      <button type="button" data-shortcuts-close aria-label="Close">
        <Icon name="close" />
      </button>
    </div>

    <section class="shortcuts-group">
      <h3>Navigation</h3>
      <table class="shortcuts-table">
        <tbody>
          <tr>
            <th scope="row" aria-label="Left arrow, Page Up, or scroll up">
              <span class="shortcut-keys" aria-hidden="true">
                <span
                  class="shortcut-key"
                  style={`--key: url("/keyboard/keyboard_arrow_left_outline.svg")`}
                ></span>
                <span class="or">or</span>
                <span
                  class="shortcut-key"
                  style={`--key: url("/keyboard/keyboard_page_up_outline.svg")`}
                ></span>
                <span class="or">or</span>
                <span
                  class="shortcut-key"
                  style={`--key: url("/keyboard/mouse_scroll_up_outline.svg")`}
                ></span>
              </span>
            </th>
            <td>Previous pages</td>
          </tr>
          <tr>
            <th scope="row" aria-label="Right arrow, Page Down, or scroll down">
              <span class="shortcut-keys" aria-hidden="true">
                <span
                  class="shortcut-key"
                  style={`--key: url("/keyboard/keyboard_arrow_right_outline.svg")`}
                ></span>
                <span class="or">or</span>
                <span
                  class="shortcut-key"
                  style={`--key: url("/keyboard/keyboard_page_down_outline.svg")`}
                ></span>
                <span class="or">or</span>
                <span
                  class="shortcut-key"
                  style={`--key: url("/keyboard/mouse_scroll_down_outline.svg")`}
                ></span>
              </span>
            </th>
            <td>Next pages</td>
          </tr>
          <tr>
            <th scope="row" aria-label="Control plus Left arrow">
              <span class="shortcut-keys" aria-hidden="true">
                <span
                  class="shortcut-key"
                  style={`--key: url("/keyboard/keyboard_ctrl_outline.svg")`}
                ></span>
                <span class="plus">+</span>
                <span
                  class="shortcut-key"
                  style={`--key: url("/keyboard/keyboard_arrow_left_outline.svg")`}
                ></span>
              </span>
            </th>
            <td>Previous chapter</td>
          </tr>
          <tr>
            <th scope="row" aria-label="Control plus Right arrow">
              <span class="shortcut-keys" aria-hidden="true">
                <span
                  class="shortcut-key"
                  style={`--key: url("/keyboard/keyboard_ctrl_outline.svg")`}
                ></span>
                <span class="plus">+</span>
                <span
                  class="shortcut-key"
                  style={`--key: url("/keyboard/keyboard_arrow_right_outline.svg")`}
                ></span>
              </span>
            </th>
            <td>Next chapter</td>
          </tr>
        </tbody>
      </table>
    </section>

    <section class="shortcuts-group">
      <h3>Fullscreen</h3>
      <table class="shortcuts-table">
        <tbody>
          <tr>
            <th scope="row" aria-label="F">
              <span class="shortcut-keys" aria-hidden="true">
                <span
                  class="shortcut-key"
                  style={`--key: url("/keyboard/keyboard_f_outline.svg")`}
                ></span>
              </span>
            </th>
            <td>Toggle fullscreen</td>
          </tr>
          <tr>
            <th scope="row" aria-label="Escape">
              <span class="shortcut-keys" aria-hidden="true">
                <span
                  class="shortcut-key"
                  style={`--key: url("/keyboard/keyboard_escape_outline.svg")`}
                ></span>
              </span>
            </th>
            <td>Exit fullscreen</td>
          </tr>
        </tbody>
      </table>
    </section>

    <section class="shortcuts-group">
      <h3>Others</h3>
      <table class="shortcuts-table">
        <tbody>
          <tr>
            <th scope="row" aria-label="Control plus scroll">
              <span class="shortcut-keys" aria-hidden="true">
                <span
                  class="shortcut-key"
                  style={`--key: url("/keyboard/keyboard_ctrl_outline.svg")`}
                ></span>
                <span class="plus">+</span>
                <span
                  class="shortcut-key"
                  style={`--key: url("/keyboard/mouse_scroll_vertical_outline.svg")`}
                ></span>
              </span>
            </th>
            <td>Zoom</td>
          </tr>
          <tr>
            <th scope="row" aria-label="Question mark">
              <span class="shortcut-keys" aria-hidden="true">
                <span
                  class="shortcut-key"
                  style={`--key: url("/keyboard/keyboard_question_outline.svg")`}
                ></span>
              </span>
            </th>
            <td>Keyboard shortcuts</td>
          </tr>
        </tbody>
      </table>
    </section>

    <p class="shortcuts-note">On a Mac, ⌘ works in place of Ctrl.</p>
  </div>
</dialog>

<style>
  #shortcuts-dialog {
    padding: 0;
    border: none;
    background: transparent;
    max-width: calc(100vw - 2rem);
  }

  #shortcuts-dialog::backdrop {
    background: rgb(0 0 0 / 0.4);
  }

  .shortcuts-panel {
    --shortcuts-ink: #000;
    --key-size: 2.5rem;
    box-sizing: border-box;
    width: min(42rem, 100%);
    padding: 1.25rem 2rem 1.35rem;
    border: 3px solid var(--shortcuts-ink);
    background: white;
    color: var(--shortcuts-ink);
  }

  .shortcuts-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .shortcuts-header h2 {
    margin: 0;
    flex: 1;
    font-size: 1.25rem;
    font-weight: 700;
  }

  [data-shortcuts-close] {
    box-sizing: border-box;
    margin: 0;
    margin-right: -0.35rem;
    padding: 0;
    width: 2.25rem;
    height: 2.25rem;
    border: 3px solid var(--shortcuts-ink);
    background: white;
    color: var(--shortcuts-ink);
    font: inherit;
    line-height: 1;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  [data-shortcuts-close]:hover,
  [data-shortcuts-close]:focus-visible {
    background: var(--shortcuts-ink);
    color: white;
  }

  .shortcuts-group {
    margin-top: 1.1rem;
  }

  .shortcuts-group h3 {
    margin: 0 0 0.35rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 0.65;
  }

  .shortcuts-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 1rem;
  }

  .shortcuts-table th,
  .shortcuts-table td {
    padding: 0.4rem 0;
    vertical-align: middle;
    font-weight: 500;
  }

  .shortcuts-table th {
    padding-right: 1.25rem;
    text-align: left;
    font-weight: 600;
    white-space: nowrap;
  }

  .shortcuts-table td {
    width: 100%;
  }

  .shortcut-keys {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
  }

  .shortcut-key {
    display: inline-block;
    width: var(--key-size);
    height: var(--key-size);
    background-color: var(--shortcuts-ink);
    -webkit-mask: var(--key) center / contain no-repeat;
    mask: var(--key) center / contain no-repeat;
  }

  .shortcuts-table .or,
  .shortcuts-table .plus {
    margin: 0 0.2em;
    font-weight: 500;
    opacity: 0.7;
  }

  .shortcuts-note {
    margin: 1rem 0 0;
    font-size: 0.9rem;
    font-weight: 500;
    opacity: 0.75;
  }
</style>
