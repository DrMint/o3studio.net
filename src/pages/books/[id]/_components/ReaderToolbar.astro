---
import type { CollectionEntry } from "astro:content";
import Button from "../../../../components/Button.astro";
import Icon from "../../../../components/Icon.astro";

interface Props {
  book: CollectionEntry<"books">;
  downloadPdfUrl: string;
}

const { book, downloadPdfUrl } = Astro.props;
---

<header id="toolbar">
  <Button href={`/books/${book.id}`} color={book.data.darkColor}>
    <Icon name="arrow_back" />
    Go back
  </Button>
  <div id="titles">
    <h1 id="book-title">
      {book.data.title}
    </h1>
    <p id="book-subtitle">{book.data.subtitle}</p>
  </div>
  <div id="toolbar-actions">
    <label id="page-jump">
      <span>Page</span>
      <input
        type="number"
        data-page-input
        min="1"
        value="1"
        inputmode="numeric"
      />
      <span data-page-count></span>
    </label>
    <div id="zoom-controls">
      <button type="button" data-zoom-out aria-label="Zoom out">
        <Icon name="zoom_out" />
      </button>
      <button type="button" data-zoom-reset>
        <span data-zoom-label>100%</span>
      </button>
      <button type="button" data-zoom-in aria-label="Zoom in">
        <Icon name="zoom_in" />
      </button>
    </div>
    <Button
      href={downloadPdfUrl}
      download={`${book.id}.pdf`}
      color={book.data.darkColor}
    >
      <Icon name="download" />
      Download
    </Button>
    <button
      type="button"
      id="shortcuts-open"
      aria-label="Keyboard shortcuts"
      title="Keyboard shortcuts"
    >
      <Icon name="keyboard-command-key" />
    </button>
    <button
      type="button"
      id="fullscreen-enter"
      aria-label="Fullscreen"
      title="Fullscreen"
    >
      <Icon name="fullscreen" />
    </button>
  </div>
</header>

<style>
  #toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    min-width: 0;
    padding: clamp(12px, 2vw, 28px);
    padding-bottom: 0;
  }

  #titles {
    min-width: 0;
    color: var(--dark-color);
  }

  @media (max-width: 1400px) {
    #titles {
      display: none;
    }
  }

  #toolbar-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 2rem;
    margin-left: auto;
  }

  #toolbar :global(a) {
    box-sizing: border-box;
    height: 50px;
    padding-block: 0;
  }

  #page-jump {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--dark-color);
    font-weight: 600;
    font-size: 1.3rem;
  }

  #page-jump input {
    box-sizing: border-box;
    height: 50px;
    max-width: 8ch;
    margin: 0;
    padding: 0 0.45em;
    border: 3px solid var(--dark-color);
    background: white;
    color: var(--dark-color);
    font: inherit;
    font-weight: 600;
    text-align: center;
  }

  #zoom-controls {
    box-sizing: border-box;
    display: flex;
    align-items: stretch;
    height: 50px;
    border: 3px solid var(--dark-color);
    background: white;
    color: var(--dark-color);
    font-size: 26px;
  }

  #zoom-controls > button {
    margin: 0;
    padding: 0 0.65em;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  #zoom-controls > button:hover,
  #zoom-controls > button:focus-visible {
    background: var(--dark-color);
    color: white;
  }

  #zoom-controls > [data-zoom-reset] {
    min-width: 4.5em;
    border-inline: 3px solid var(--dark-color);
    font-weight: 600;
    font-size: 1.2rem;
  }

  #zoom-controls > button:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  #zoom-controls > button:disabled:hover {
    background: transparent;
    color: inherit;
  }

  #book-title {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.2;
  }

  #book-subtitle {
    font-size: 0.9rem;
    margin: 0;
  }

  #fullscreen-enter,
  #shortcuts-open {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    width: 50px;
    height: 50px;
    border: 3px solid var(--dark-color);
    background: white;
    color: var(--dark-color);
    font: inherit;
    line-height: 1;
    cursor: pointer;
    user-select: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  #fullscreen-enter:hover,
  #fullscreen-enter:focus-visible,
  #shortcuts-open:hover,
  #shortcuts-open:focus-visible {
    background: var(--dark-color);
    color: white;
  }
</style>
